APP_MODE=dev

# HOSTNAME
HOST=http://localhost:3010/api
PORT=3010

# AUTHENTICATION
JWT_SECRET=CAMBIAR_POR_SECRETO_LARGO
JWT_EXPIRES_IN=12h

# USUARIO ADMINISTRADOR CREADO POR EL SEED
LOGIN_NAME=Administrador
LOGIN_EMAIL=admin@tickets.local
LOGIN_PASSWORD=CAMBIAR_Abc123

# DATOS DE EJEMPLO (true = el seed carga sedes y tickets ficticios para probar la app)
SEED_EXAMPLE_TICKETS=false

# PRISMA
DATABASE_URL="postgresql://tickets:CAMBIAR_PASSWORD_DB@localhost:5437/tickets_db?schema=public"

# DOCKER COMPOSE (POSTGRESQL)
DB_PS_DATABASE=tickets_db
DB_PS_USERNAME=tickets
DB_PS_PASSWORD=CAMBIAR_PASSWORD_DB
DB_PS_PORT=5437
DB_PS_DOCKER_PORT=5432
DB_PS_DOCKER_VOLUME=./postgres-data
