generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  user
}

enum TicketStatus {
  OPEN
  IN_ANALYSIS
  WAITING_INFO
  ESCALATED_DEV
  RESOLVED
  CLOSED
  CANCELLED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketChannel {
  WHATSAPP
  EMAIL
  CALL
  IN_PERSON
  PORTAL
  OTHER
}

enum RootCause {
  OPERATIONAL_ERROR
  SYSTEM_DEFECT
  USER_MISINTERPRETATION
  MASTER_DATA
  NO_ISSUE
  OTHER
}

enum NotificationType {
  NEW_PORTAL_TICKET
  REQUESTER_REPLY
  TICKET_ASSIGNED
}

enum TicketEventType {
  CREATED
  STATUS_CHANGED
  NOTE
  ASSIGNED
  UPDATED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  roles     UserRole @default(user)
  isActive  Boolean  @default(true)
  isSystem  Boolean  @default(false)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Notifications   Notification[]
  AssignedTickets Ticket[]       @relation("TicketAssignee")
  CreatedTickets  Ticket[]       @relation("TicketCreator")
  TicketEvents    TicketEvent[]

  @@index([isDeleted])
}

model Organization {
  id                 Int      @id @default(1)
  name               String
  taxId              String?
  email              String?
  phone              String?
  address            String?
  website            String?
  portalEnabled      Boolean  @default(false)
  portalMessage      String?
  portalEmailEnabled Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Site {
  id        Int      @id @default(autoincrement())
  code      String?
  name      String
  isActive  Boolean  @default(true)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Tickets Ticket[]

  @@index([isDeleted])
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean  @default(true)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  Tickets Ticket[]

  @@index([isDeleted])
}

model Ticket {
  id                Int            @id @default(autoincrement())
  code              String?        @unique
  title             String
  description       String
  requesterName     String
  requesterArea     String?
  requesterEmail    String?
  requesterLanguage String?
  publicToken       String?        @unique
  siteId            Int?
  channel           TicketChannel  @default(WHATSAPP)
  categoryId        Int?
  priority          TicketPriority @default(MEDIUM)
  status            TicketStatus   @default(OPEN)
  rootCause         RootCause?
  productCodes      String[]       @default([])
  documents         String[]       @default([])
  affectedUnits     Int?
  diagnosis         String?
  closureComment    String?
  devRequestRef     String?
  evidencePaths     String[]       @default([])
  reportedAt        DateTime       @default(now())
  firstResponseAt   DateTime?
  resolvedAt        DateTime?
  closedAt          DateTime?
  isDeleted         Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  Site        Site?     @relation(fields: [siteId], references: [id])
  Category    Category? @relation(fields: [categoryId], references: [id])
  assigneeId  Int?
  Assignee    User?     @relation("TicketAssignee", fields: [assigneeId], references: [id])
  createdById Int
  CreatedBy   User      @relation("TicketCreator", fields: [createdById], references: [id])

  Events        TicketEvent[]
  Notifications Notification[]

  @@index([status])
  @@index([siteId])
  @@index([categoryId])
  @@index([reportedAt])
  @@index([isDeleted])
}

model TicketEvent {
  id         Int             @id @default(autoincrement())
  type       TicketEventType
  fromStatus TicketStatus?
  toStatus   TicketStatus?
  note       String?
  isPublic   Boolean         @default(false)
  authorName String?
  createdAt  DateTime        @default(now())

  ticketId Int
  Ticket   Ticket @relation(fields: [ticketId], references: [id])
  userId   Int
  User     User   @relation(fields: [userId], references: [id])

  @@index([ticketId])
}

model Notification {
  id        Int              @id @default(autoincrement())
  type      NotificationType
  actorName String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  userId   Int
  User     User   @relation(fields: [userId], references: [id])
  ticketId Int
  Ticket   Ticket @relation(fields: [ticketId], references: [id])

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model PortalAccess {
  id        Int      @id @default(autoincrement())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}
